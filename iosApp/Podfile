target 'iosApp' do
  use_frameworks!
  platform :ios, '16.0'
  pod 'shared', :path => '../shared'
  pod 'FirebaseCore'
  pod 'FirebaseAuth'
  # Vendored whisper.cpp xcframework (feature/agent/whisper.podspec) — the shared/ComposeApp
  # framework is static, so its own build doesn't need to resolve whisper.cpp symbols; they only
  # surface as undefined at the app's link step, which this pod supplies.
  pod 'whisper', :path => '../feature/agent'
end

# Enforce minimum deployment target for all pods
post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      if config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'].to_f < 12.0
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '12.0'
      end
    end
  end
end