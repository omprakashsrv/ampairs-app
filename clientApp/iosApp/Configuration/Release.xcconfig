// White-label client iOS build config (Release). See Debug.xcconfig for how per-client selection
// works. Defaults below = the "ambika" client (clients/ambika/config.properties).
#include? "Client-ambika.xcconfig"

TEAM_ID=
BUNDLE_ID=com.ampairs.app.ambika
APP_NAME=Ambika Enterprise
PRODUCT_NAME=iosApp
GOOGLE_SERVICE=$(SRCROOT)/Firebase/GoogleService-Info-Production.plist

// Consumed by iosApp/Info.plist → ContentView (StorefrontViewController args).
AMPAIRS_WORKSPACE_SLUG=ambika-enterprise
AMPAIRS_THEME_COLOR_ARGB=FF1B6C4A

CURRENT_PROJECT_VERSION=2
MARKETING_VERSION=1.0.1
