# Firebase config for the storefront iOS apps (contains sensitive API keys)
marketplaceApp/iosApp/Firebase/GoogleService-Info-*.plist
clientApp/iosApp/Firebase/GoogleService-Info-*.plist

# Firebase configuration (contains sensitive API keys)
google-services.json
GoogleService-Info.plist

# Sentry configuration with auth token
**/common-sentry.properties

# Android keystore files (contain sensitive signing credentials)
*.jks
*.keystore
ampairs.jks

# Play Console publishing service-account key (gradle-play-publisher)
play-service-account.json

# Android release build outputs (APK/AAB/baseline profiles — large binaries)
androidApp/release/
